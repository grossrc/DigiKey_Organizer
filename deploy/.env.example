# The following are you digikey credentials. You must obtain these from digikey- see README for more info.
DIGIKEY_CLIENT_ID=your_client_id
DIGIKEY_CLIENT_SECRET=your_client_secret

# the default installation code is created with the user murph. Keep this if you didn't change it. The default password is also password, if you change that make sure you reflect it in the following steps.
PGHOST=localhost
PGPORT=5432
PGDATABASE=parts_DB
PGUSER=murph
PGPASSWORD=password

FLASK_DEBUG=0

# This is used if you want to connect LLMs to the program's database. It's not required for the program to function, and you can fill it out later. See the README update section on LLM integration.
# Everything below can also be managed from http://lab-parts.local/mcp-admin on your LAN.
# LEAVE THESE BLANK IF NOT USING - don't touch...
NGROK_AUTHTOKEN=
# Optional reserved ngrok domain so the MCP URL stays the same across restarts.
NGROK_DOMAIN=

# Optional fallback: a fixed token clients may send as "Authorization: Bearer <token>".
# Normally you don't need this - generate per-client access keys at /mcp-admin instead.
MCP_BEARER_TOKEN=